{
  "name": "my-agent",
  "version": "1.0.0",
  "description": "TypeScript CLI agent powered by OpenRouter with Telegram integration",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:telegram": "tsx src/index.ts --telegram",
    "dev:watch": "tsx watch --ignore './data' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:telegram": "node dist/index.js --telegram",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@inquirer/prompts": "^5.1.2",
    "@openrouter/sdk": "latest",
    "better-sqlite3": "^11.1.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "googleapis": "^144.0.0",
    "grammy": "^1.27.0",
    "node-cron": "^3.0.3",
    "openai": "^6.37.0",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.19.41",
    "@types/node-cron": "^3.0.11",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
